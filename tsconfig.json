{
    "compilerOptions": {
        "target": "es5",
        "module": "commonjs",
        "declaration": true,
        "noImplicitAny": false,
        "outDir": "./lib",
        "strict": true,
        "paths": {
            "~/*": [
                "./*"
            ],
            "@/*": [
                "./*"
            ]
        }
    },
    "include": ["src"],
    "exclude": ["node_modules", "**/__tests__/*"]
}
